 pub const DEFAULT_TILE_SIZE: u32 = 1024;
+const MAX_DISPATCHES_PER_SUBMISSION: usize = 256;
+
+// Each dispatch binds a separate aligned slice, so later rounds never overwrite
+// tile/permutation data that an earlier dispatch is still using.
+fn storage_slots(bytes: u64, rounds: usize, limits: &wgpu::Limits) -> Result<(u64, u64)> {
+    anyhow::ensure!(rounds > 0 && bytes > 0, "empty RR dispatch data");
+    anyhow::ensure!(
+        bytes <= u64::from(limits.max_storage_buffer_binding_size),
+        "RR dispatch data exceeds storage binding limit"
+    );
+    let alignment = u64::from(limits.min_storage_buffer_offset_alignment);
+    let stride = bytes.div_ceil(alignment) * alignment;
+    let size = stride
+        .checked_mul(rounds as u64)
+        .context("RR buffer size overflow")?;
+    anyhow::ensure!(
+        size <= limits.max_buffer_size,
+        "RR dispatch buffer exceeds GPU limit"
+    );
+    anyhow::ensure!(
+        stride * (rounds as u64 - 1) <= u64::from(u32::MAX),
+        "RR dynamic offset exceeds u32"
+    );
+    Ok((stride, size))
+}
 
